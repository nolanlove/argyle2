# Copy to .env for local development. Never commit .env.

# --- Django ---
DEBUG=True
SECRET_KEY=dev-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me

# Comma-separated. Used when DEBUG=False; ignored otherwise (defaults to localhost).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database ---
# Local Postgres via docker-compose:
DATABASE_URL=postgres://argyle:argyle@localhost:5432/argyle
# (Leave blank to fall back to db.sqlite3.)

# --- OpenAI ---
OPENAI_API_KEY=

# --- Email (optional in dev; console backend is used when these are absent) ---
# BREVO_API_KEY=
# BREVO_SMTP_KEY=
# BREVO_SMTP_LOGIN=
# FORCE_CONSOLE_EMAIL=True
